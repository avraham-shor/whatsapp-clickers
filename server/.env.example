# All variables are REQUIRED at boot (fail-fast) unless marked optional.
# Copy to server/.env for local development — never commit real values.

# PostgreSQL connection string.
# Local Docker: docker run -d -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=whatsapp_clickers -p 5432:5432 postgres:17
DATABASE_URL=postgres://postgres:dev@localhost:5432/whatsapp_clickers

# Meta WhatsApp Cloud API (Epic 2 consumes these; dummy values are fine until then)
WHATSAPP_ACCESS_TOKEN=dummy
WHATSAPP_PHONE_NUMBER_ID=dummy
WHATSAPP_APP_SECRET=dummy
WHATSAPP_VERIFY_TOKEN=dummy

# Anthropic API key for AI semantic answer validation (Epic 3)
ANTHROPIC_API_KEY=dummy

# Secret for signing session tokens (HMAC). Must be >= 32 chars and NOT start
# with "change-me" — the server refuses to boot otherwise. Generate a real one:
#   Git Bash / Linux:  openssl rand -base64 48
#   PowerShell:        [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
SESSION_SECRET=change-me-long-random-string

# Optional — HTTP port, defaults to 8080. Railway injects this automatically.
#PORT=8080
